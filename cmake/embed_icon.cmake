# embed_icon.cmake - generates gui_icon_data.cpp from the raw RGBA window
# icon (packaging/jot-icon-128.rgba, produced by packaging/make_gui_icon.py).
#
# Usage:
#   cmake -DINPUT=<abs path to .rgba> -DSIZE=<px> -DOUTPUT=<gui_icon_data.cpp>
#         -P embed_icon.cmake
#
# The output defines, inside namespace jot_gui:
#   const unsigned char kWindowIconPixels[];  // RGBA8888, SIZE x SIZE
#   const int kWindowIconSize;
# which src/ui/gui/gui_setup.cpp hands to SDL_SetWindowIcon, so the official
# artwork ships inside the binary instead of an installed data file.

if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SIZE)
  message(FATAL_ERROR "embed_icon.cmake: INPUT, SIZE and OUTPUT are required")
endif()

file(READ "${INPUT}" CONTENT HEX)
string(LENGTH "${CONTENT}" HEX_LEN)
math(EXPR EXPECTED_HEX "${SIZE} * ${SIZE} * 4 * 2")
if(NOT HEX_LEN EQUAL EXPECTED_HEX)
  message(FATAL_ERROR
    "embed_icon.cmake: ${INPUT} holds ${HEX_LEN} hex chars, "
    "expected ${EXPECTED_HEX} for ${SIZE}x${SIZE} RGBA")
endif()

# One "0xNN, " entry per byte, the same shape embed_lua.cmake emits.
string(REGEX REPLACE "(..)" "0x\\1, " BYTES "${CONTENT}")

set(GEN "// Generated by cmake/embed_icon.cmake - do not edit.\n")
string(APPEND GEN "// Regenerate the input with packaging/make_gui_icon.py.\n")
string(APPEND GEN "#include \"gui/gui_icon.h\"\n\n")
string(APPEND GEN "namespace jot_gui\n{\n")
string(APPEND GEN "const unsigned char kWindowIconPixels[] = { ${BYTES} };\n")
string(APPEND GEN "const int kWindowIconSize = ${SIZE};\n")
string(APPEND GEN "} // namespace jot_gui\n")

file(WRITE "${OUTPUT}" "${GEN}")
message(STATUS "embedded window icon: wrote ${OUTPUT} (${SIZE}x${SIZE} RGBA)")
