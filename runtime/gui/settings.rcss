/* Settings overlay stylesheet. Colors come from jot's active theme: the
   overlay refreshes the --* custom properties on #settings-root whenever
   the theme changes (see gui_settings.cpp apply_palette). */

#settings-root {
  --bg: rgb(38, 38, 38);
  --fg: rgb(215, 215, 215);
  --accent: rgb(95, 135, 168);
  --border: rgb(70, 70, 70);
  --muted: rgb(140, 140, 140);
  --sel-bg: rgb(58, 58, 58);
  width: 100%;
  height: 100%;
  font-family: jot-ui;
  font-size: 15px;
  color: var(--fg);
}

#scrim {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* RmlUi parses alpha with atoi(), so 0-255 integer only (115 = 45%). */
  background: rgba(0, 0, 0, 115);
}

#stage {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 0;
  left: 0;
}

#panel {
  width: 430px;
  background: var(--bg);
  border-width: 1px;
  border-color: var(--border);
  border-radius: 8px;
  padding: 18px 20px;
  position: relative;
}

h1 {
  font-size: 19px;
  font-weight: bold;
  color: var(--accent);
  margin: 0 0 14px 0;
}

.row {
  margin: 12px 0;
}

label {
  display: block;
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 5px;
}

select {
  width: 100%;
  background: var(--sel-bg);
  color: var(--fg);
  border-width: 1px;
  border-color: var(--border);
  border-radius: 4px;
  padding: 5px 8px;
}

select option {
  background: var(--sel-bg);
  color: var(--fg);
}

input[type=range] {
  width: 100%;
}

.value-hint {
  margin-top: 4px;
  color: var(--muted);
  font-size: 13px;
  text-align: right;
}

#close-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  background: transparent;
  border: 0px;
  color: var(--muted);
  font-size: 16px;
  padding: 2px 8px;
  border-radius: 4px;
}

#close-btn:hover {
  background: var(--sel-bg);
  color: var(--fg);
}

#footer {
  margin-top: 18px;
  text-align: right;
}

button {
  background: var(--accent);
  color: rgb(20, 20, 20);
  border: 0px;
  border-radius: 4px;
  padding: 7px 18px;
  font-size: 14px;
}

button:hover {
  background: var(--fg);
}