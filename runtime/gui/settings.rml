<rml>
<head>
  <link type="text/rcss" href="settings.rcss"/>
</head>
<body id="settings-root">
  <div id="scrim"></div>
  <div id="stage">
    <div id="panel">
      <button id="close-btn">×</button>
      <h1>Settings</h1>

      <div class="row">
        <label for="theme">Theme</label>
        <select id="theme"></select>
      </div>

      <div class="row">
        <label for="font-size">Font size</label>
        <input type="range" id="font-size" min="8" max="40" step="1"/>
        <div id="font-size-value" class="value-hint"></div>
      </div>

      <div class="row">
        <label for="cursor-style">Cursor style</label>
        <select id="cursor-style">
          <option value="block">Block</option>
          <option value="bar">Bar</option>
          <option value="steady_block">Steady block</option>
        </select>
      </div>

      <div id="footer">
        <button id="done-btn">Done</button>
      </div>
    </div>
  </div>
</body>
</rml>